# ==============================================================================
# After School Club CMS — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE MANDATORY CONFIGURATION
# ------------------------------------------------------------------------------

# PostgreSQL Connection String (Pooler or direct connection)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/after_school_club

# Primary NextAuth / Session Secret (at least 32 characters)
AUTH_SECRET=your_super_secret_auth_key_at_least_32_chars_long

# Canonical Public Domain URL (Used for generating magic links and email links)
# Production example: https://after-school-club.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (OPTIONAL / PRODUCTION RECOMMENDED)
# ------------------------------------------------------------------------------

# Dedicated Parent Portal JWT Session Secret (Falls back to AUTH_SECRET if unset)
PARENT_SESSION_SECRET=your_super_secret_parent_session_jwt_key_32_chars

# NextAuth URL (Optional in Vercel; recommended in custom deployments)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Provider (Optional — for staff single sign-on)
# AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# 3. MACHINE / CRON AUTHENTICATION
# ------------------------------------------------------------------------------

# Secret token required in Authorization: Bearer <CRON_SECRET> for /api/cron/**
CRON_SECRET=your_super_secret_cron_bearer_token_string

# ------------------------------------------------------------------------------
# 4. EMAIL & COMMUNICATIONS (RESEND & TWILIO)
# ------------------------------------------------------------------------------

# Resend API Key for transactional emails (invites, magic links, receipts)
# RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email Address and Name
FROM_EMAIL=noreply@sprintscaleit.co.uk
FROM_NAME=SprintScale

# Twilio Credentials for SMS Notifications (Optional)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+44XXXXXXXXXX

# ------------------------------------------------------------------------------
# 5. PAYMENT PROVIDERS (STRIPE & GOCARDLESS)
# ------------------------------------------------------------------------------

# Stripe Secret & Webhook Keys (Required for online invoice payments)
# STRIPE_SECRET_KEY=sk_live_... (or sk_test_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... (or pk_test_...)

# GoCardless Direct Debit (Optional)
# GOCARDLESS_ACCESS_TOKEN=your_gocardless_access_token_here
# GOCARDLESS_ENVIRONMENT=live # or sandbox

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ------------------------------------------------------------------------------

# Upstash Redis REST credentials for multi-instance serverless rate limiting
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# 7. STORAGE & EMBEDDING
# ------------------------------------------------------------------------------

# Vercel Blob Storage Token (Injected automatically on Vercel deployments)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# iFrame Embedding CSP (Comma-separated list of allowed parent website domains)
# Example: ALLOWED_FRAME_ANCESTORS=https://your-school-site.com, https://partner-site.com
ALLOWED_FRAME_ANCESTORS=

# Sentry Error Monitoring (Optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
